{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "module": "ESNext",
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./*"]
    },
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-native"
  },
  "include": [
    "*.ts",
    "**/*.ts",
    "**/*.tsx",
    "declaration.d.ts"
  ],
  "lib": ["esnext", "dom"]
}
